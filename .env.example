# ---- Binoex configuration ----
PORT=3000
NODE_ENV=development

# Public URL of this exchange (used in emails / links)
APP_URL=http://localhost:3000

# ---- Mode ----
# true  = paper trading (accounts in our DB, simulated fills on live prices; no Bybit key needed)
# false = real trading through the Bybit institutional master account below
# (defaults to paper when BYBIT_API_KEY is empty)
PAPER_MODE=true
PAPER_START_BALANCE=100000

# ---- Bybit institutional master account ----
# Create this key on your Bybit INSTITUTIONAL master account with:
#   - Sub-account management  (create sub UIDs, create sub API keys)
#   - Wallet: Deposit/Withdraw + Transfer (universal transfer sub <-> master)
#   - Read-only: Account/Asset (sub balance / deposit record queries)
# Lock it to this server's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# https://api.bybit.com  (prod)  |  https://api-testnet.bybit.com (testnet)
BYBIT_REST_URL=https://api.bybit.com
# wss://stream.bybit.com  (prod)  |  wss://stream-testnet.bybit.com (testnet)
BYBIT_WS_URL=wss://stream.bybit.com
BYBIT_RECV_WINDOW=5000

# ---- Security ----
# 32+ random bytes, hex.  openssl rand -hex 32
JWT_SECRET=
# 32 bytes hex (64 hex chars) used to AES-256-GCM encrypt sub-account API secrets at rest.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ---- Exchange products exposed to users ----
# Comma separated. Services are ALSO gated by what the master key is permitted
# to do on Bybit (see GET /api/services). Options: spot,linear,inverse,option,earn
ENABLED_SERVICES=spot,linear
# Markets shown in the UI (Bybit symbols)
SPOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,TONUSDT
LINEAR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Deposit coins/chains offered. Format COIN:CHAIN, comma separated.
DEPOSIT_ASSETS=USDT:TRX,USDT:ETH,USDT:ARBI,USDC:ETH,BTC:BTC,ETH:ETH,SOL:SOL

# SQLite path
DATABASE_PATH=./data/binoex.db
