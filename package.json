{
  "name": "binoex",
  "version": "0.1.0",
  "description": "Binoex - white-label crypto exchange on top of the Bybit V5 API (institutional sub-accounts)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --no-warnings=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\""
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0"
  }
}
